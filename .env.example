# 检索后端：searxng = 真实 SearXNG；fixture = 固定样本（无 Docker 也能验收闭环）
SEARCH_PROVIDER=searxng
SEARXNG_URL=http://127.0.0.1:8888
SEARCH_TIMEOUT=8.0   # 聚合请求要覆盖 SearXNG 自己的引擎超时

# 服务绑定（M0 只绑本机）
API_HOST=127.0.0.1
API_PORT=8000

# 前端产物目录（发布形态由 FastAPI 同源托管）；留空用 apps/web/dist
WEB_DIST=
SERVE_WEB=true

# M1 起使用
BRAVE_API_KEY=
SERPER_API_KEY=
GSB_API_KEY=
URLHAUS_AUTH_KEY=
OPENPHISH_FEED=https://openphish.com/feed.txt
LLM_BASE_URL=http://127.0.0.1:11434/v1
# Compose 单独配置容器可访问的模型地址；留空使用抽取式桩（LLM_PROVIDER 也应留空）。
COMPOSE_LLM_BASE_URL=
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
# 按 ollama list 改为已安装的模型名。支持时可设 none 关闭思考，留空由端点决定。
LLM_REASONING_EFFORT=
# 留空时按 LLM_BASE_URL 自动判定：有地址走 openai 兼容端点，没有则用本地抽取式桩
LLM_PROVIDER=
# 等待首段可见正文和正文流读取的超时（秒）
LLM_TIMEOUT=30
LLM_STUB_DELAY=0.02

# 侧栏总结的搜索快照：内存保存时长与条数上限
SESSION_TTL=900
SESSION_CAPACITY=64
EMBED_MODEL=bge-m3
DB_PATH=./data/cs.db
FETCH_CONCURRENCY=6
FETCH_TIMEOUT=2.5
FETCH_MAX_BYTES=2000000
FETCH_MAX_REDIRECTS=3
# 仅供本机透明代理。例外只适用于解析到 198.18.0.0/15 内的地址，缺省关闭。
FETCH_EXTRA_CIDRS=

# 缓存：搜索结果 TTL（秒）、总开关、每张缓存表保留的条数
CACHE_ENABLED=true
CACHE_TTL=900

# 一键添加：跨域写书签的 token 文件（首次访问 /api/tools/bookmarklet 自动生成）
API_TOKEN_PATH=data/api-token.txt

# 熔断：连续失败次数与冷却秒数（upstream 与单引擎分别计数）
BREAKER_ENABLED=true
BREAKER_FAILS=3
BREAKER_COOLDOWN=3600

# 黑名单 feed：无 key 的纯文本源（逗号分隔，如 OpenPhish）；GSB/URLhaus 需 key 未接入
FEED_URLS=
FEED_OUTPUT_PATH=data/blocklist-feeds.txt
CACHE_MAX_ENTRIES=512